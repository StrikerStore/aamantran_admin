# Local dev: leave VITE_API_URL unset so Vite proxies /api/v1 to the backend.
# Production (Railway): set both to your API origin (no trailing slash).
# VITE_API_URL=https://api.aamantran.online
VITE_PUBLIC_INVITE_BASE_URL=http://localhost:4000
# Production: VITE_PUBLIC_INVITE_BASE_URL=https://api.aamantran.online

# Public marketing site (Next.js) — used for the "View live" blog link.
# Defaults: http://localhost:3000 (dev), https://www.aamantran.online (prod).
# VITE_LANDING_URL=http://localhost:3000
